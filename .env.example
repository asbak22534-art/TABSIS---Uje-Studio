# TABUNGAN SISWA - ENVIRONMENT CONFIGURATION
NODE_ENV="development"
PORT=3000

# Required only for production; exact public origin of the app.
APP_ORIGIN=""

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_RANDOM_64_HEX"
SESSION_TTL_SECONDS=28800

# Google Apps Script Web App deployment ending in /exec.
GAS_SCRIPT_URL=""
# Same secret must be stored in Apps Script Project Settings -> Script Properties -> GAS_API_SECRET.
GAS_API_SECRET="CHANGE_ME_RANDOM_64_HEX_DIFFERENT_FROM_SESSION_SECRET"

MAX_TRANSACTION_AMOUNT=10000000
CACHE_TTL_MS=5000
TRUST_PROXY=false
